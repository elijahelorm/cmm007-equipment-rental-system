<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title><%= title %> | Equipment Rental System</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">

</head>
<body class="login-page-body">
    <div class="login-container">
        <div class="login-card">
            <div class="login-card-header">
                <h1>🔧 Equipment Rental</h1>
                <p>Management System</p>
            </div>
            
            <div class="login-card-body">
                <!-- Display error message if exists -->
                <% if (error) { %>
                    <div class="login-alert login-alert-error">
                        ⚠️ <%= error %>
                    </div>
                <% } %>
                
                <!-- Display success message if exists -->
                <% if (message) { %>
                    <div class="login-alert login-alert-success">
                        ✅ <%= message %>
                    </div>
                <% } %>
                
                <!-- Login Form -->
                <form action="/auth/login" method="POST">
                    <div class="login-form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" required placeholder="admin@example.com" autocomplete="email">
                    </div>
                    
                    <div class="login-form-group">
                        <label>Password</label>
                        <input type="password" name="password" required placeholder="••••••" autocomplete="current-password">
                    </div>
                    
                    <div class="login-form-group">
                        <label>Login as</label>
                        <select name="role" required>
                            <option value="user">User</option>
                            <option value="admin">Administrator</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="login-btn">Login →</button>
                </form>
                
                <div class="login-divider">
                    <span>Don't have an account? </span>
                    <a href="#" onclick="showRegisterModal()" class="login-link">Register here</a>
                </div>
                
                <div class="login-demo-info">
                    <h4>📌 Demo Credentials</h4>
                    <p><strong>Admin:</strong> admin@example.com / Admin@123</p>
                    <p><strong>User:</strong> Register a new account above</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Registration Modal -->
    <div id="registerModal" class="login-modal">
        <div class="login-modal-content">
            <div class="login-modal-header">
                <h3>Create New Account</h3>
            </div>
            <div class="login-modal-body">
                <form action="/auth/register" method="POST" id="registerForm">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="fullName" required placeholder="John Doe">
                    </div>
                    
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" required placeholder="john@example.com">
                    </div>
                    
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="password" required placeholder="Minimum 6 characters">
                        <span class="input-hint">Password must be at least 6 characters</span>
                    </div>
                    
                    <div class="login-modal-buttons">
                        <button type="submit" class="login-btn">Register →</button>
                        <button type="button" class="login-btn" onclick="closeRegisterModal()" style="background: #6c757d;">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script src="/js/login.js"></script>
</body>
</html>